# =============================================================================
# PrismaLama Inference Server — AMD ROCm Build
# JAISIU-2146 / JAISIU-2156 (DeepSeek-V4.1 deepseek41 CPU ship)
#
# Ship path: rebuild vendored llama.cpp (deepseek41 + Engram) as CPU libllama /
# llama-server, reuse a known-good ollama Go binary from prismalama:rocm-pre-deepseek41.
# HIP backend is best-effort; Go/MLX rebuild is deferred (mlx header + sampling_ext
# conflicts on this tree).
#
# GPU: AMD Radeon RX 7900 XT/XTX/GRE (Navi 31 = gfx1100)
# =============================================================================

ARG ROCM_BASE=rocm/dev-ubuntu-24.04:7.2.4-complete
ARG OLLAMA_BIN_IMAGE=prismalama:rocm-pre-deepseek41

# -----------------------------------------------------------------------------
# Stage 1 — builder: CPU (and optional HIP) llama-server from vendored llama.cpp
# -----------------------------------------------------------------------------
FROM ${ROCM_BASE} AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    CGO_ENABLED=1 \
    ROCM_PATH=/opt/rocm \
    HIP_PATH=/opt/rocm \
    PATH=/opt/rocm/bin:/usr/local/go/bin:${PATH} \
    AMDGPU_TARGETS=gfx1100 \
    GPU_ARCHS=gfx1100 \
    HSA_OVERRIDE_GFX_VERSION=11.0.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git \
    build-essential cmake ninja-build pkg-config \
    libvulkan1 libvulkan-dev mesa-vulkan-drivers vulkan-tools \
    glslc glslang-tools \
    && rm -rf /var/lib/apt/lists/*

ARG GO_VERSION=1.24.1
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
    | tar -C /usr/local -xz

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY ./ ./

ENV OLLAMA_LLAMA_CPP_SOURCE=/src/llama/llama.cpp
# Prefer CPU+HIP; if HIP fails, still ship CPU deepseek41 libllama.
RUN cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DOLLAMA_LLAMA_BACKENDS=rocm_v7_2 \
        -DOLLAMA_MLX_BACKENDS= \
        -DCMAKE_HIP_ARCHITECTURES="${AMDGPU_TARGETS}" \
        -DAMDGPU_TARGETS="${AMDGPU_TARGETS}" \
        -DGGML_CUDA=OFF \
    && cmake --build build --target ollama-llama-server-local --parallel "$(nproc)" \
    && (cmake --build build --target ollama-llama-server-backends --parallel "$(nproc)" \
        || echo "WARN: HIP backend build failed — shipping CPU deepseek41 libllama") \
    && test -d /src/build/lib/ollama \
    && test -e /src/build/lib/ollama/libllama.so \
    && (strings /src/build/lib/ollama/libllama.so | grep -q deepseek41 \
        || strings /src/build/lib/ollama/libllama.so.* | grep -q deepseek41) \
    && echo "OK: staged libllama contains deepseek41" \
    && mkdir -p /out/lib/ollama \
    && cp -a /src/build/lib/ollama/. /out/lib/ollama/ \
    && ls -la /out/lib/ollama | head -40

# -----------------------------------------------------------------------------
# Known-good Go server binary (avoids mlx/imagegen + sampling_ext CGO breakages)
# -----------------------------------------------------------------------------
FROM ${OLLAMA_BIN_IMAGE} AS ollama-bin

# -----------------------------------------------------------------------------
# Stage 2 — runtime: slim Ubuntu + ROCm runtime libs only
# -----------------------------------------------------------------------------
FROM ${ROCM_BASE} AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    OLLAMA_LIBRARY_PATH=/usr/lib/ollama/rocm_v7_2 \
    OLLAMA_HOST=0.0.0.0:11434 \
    OLLAMA_MODELS=/home/ollama/.ollama \
    OLLAMA_KEEP_ALIVE=24h \
    OLLAMA_NUM_PARALLEL=2 \
    OLLAMA_MAX_LOADED_MODELS=1 \
    HIP_VISIBLE_DEVICES=0 \
    CUDA_VISIBLE_DEVICES="" \
    HSA_OVERRIDE_GFX_VERSION=11.0.0 \
    AMDGPU_TARGETS=gfx1100 \
    PATH=/opt/rocm/bin:${PATH} \
    LD_LIBRARY_PATH=/usr/lib/ollama/rocm_v7_2:/usr/lib/ollama:/opt/rocm/lib

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /home/ollama/.ollama /usr/lib/ollama/rocm_v7_2 /root/.ollama \
    && useradd -m -s /bin/bash ollama \
    && chown -R ollama:ollama /home/ollama/.ollama /usr/lib/ollama

# New deepseek41 libllama + llama-server (+ rocm_v7_2 HIP when backends built)
COPY --from=builder /out/lib/ollama/ /usr/lib/ollama/
# Compat alias: compose llm-local.rocm.yml still sets OLLAMA_LIBRARY_PATH=.../rocm
RUN if [ -d /usr/lib/ollama/rocm_v7_2 ] && [ ! -e /usr/lib/ollama/rocm ]; then \
      ln -sfn rocm_v7_2 /usr/lib/ollama/rocm; \
    fi
# Working ollama Go binary from pre-deepseek41 image (both paths compose uses)
COPY --from=ollama-bin /usr/bin/ollama /usr/bin/ollama
COPY --from=ollama-bin /usr/bin/ollama /bin/ollama
# ROCm runtime (HIP libs) — needed when/if rocm runner dir is present
COPY --from=builder /opt/rocm/lib/ /opt/rocm/lib/

EXPOSE 11434

# Compose llm-local uses entrypoint [/bin/ollama] as root with OLLAMA_MODELS=/root/.ollama
USER root
WORKDIR /root

ENTRYPOINT ["/bin/ollama"]
CMD ["serve"]
