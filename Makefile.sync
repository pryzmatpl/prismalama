# Prismallama tracks **our** fork (prismallama.cpp), not ggml-org directly — same policy as our AirLLM fork.
# Bump FETCH_HEAD after merging ggml-org/llama.cpp (or Ollama’s pinned llama SHA) **into** prismallama.cpp on GitHub.
UPSTREAM=https://github.com/piotroxp/prismallama.cpp.git
WORKDIR=llama/vendor
FETCH_HEAD=35bca9f9089fb1bf9219ddf1415c8fe5e9a3d8dc

.PHONY: help
help:
	@echo "Available targets:"
	@echo "    sync                 Sync with upstream repositories"
	@echo "    checkout             Checkout upstream repository"
	@echo "    apply-patches        Apply patches to local repository"
	@echo "    format-patches       Format patches from local repository"
	@echo "    clean                Clean local repository"
	@echo
	@echo "Example:"
	@echo "    make -f $(lastword $(MAKEFILE_LIST)) clean apply-patches sync"

.PHONY: sync
sync: llama/build-info.cpp ml/backend/ggml/ggml/src/ggml-metal/ggml-metal-embed.metal

llama/build-info.cpp: llama/build-info.cpp.in llama/llama.cpp
	sed -e 's|@FETCH_HEAD@|$(FETCH_HEAD)|' <$< >$@

# llama/llama.cpp is a git submodule pinned to FETCH_HEAD. Use `git submodule update`
# instead of rsync — the rsync targets below are kept for backward compat with CI scripts
# that still run `make -f Makefile.sync sync` and expect them to exist.
.PHONY: llama/llama.cpp
llama/llama.cpp:
	git submodule update --init --recursive --checkout $<
	@echo "llama/llama.cpp pinned to FETCH_HEAD $(FETCH_HEAD) via submodule"

.PHONY: ml/backend/ggml/ggml
ml/backend/ggml/ggml:
	@if [ ! -d llama/llama.cpp/ggml ]; then \
		echo "llama/llama.cpp submodule not initialized — run 'git submodule update --init' first"; \
		exit 1; \
	fi
	@echo "ml/backend/ggml/ggml/ now sources from llama/llama.cpp/ggml/ submodule (no rsync needed)"

ml/backend/ggml/ggml/src/ggml-metal/ggml-metal-embed.metal: ml/backend/ggml/ggml
	go generate ./$(@D)

PATCHES=$(wildcard llama/patches/*.patch)
PATCHED=$(join $(dir $(PATCHES)), $(addsuffix ed, $(addprefix ., $(notdir $(PATCHES)))))

.PHONY: apply-patches
.NOTPARALLEL:
apply-patches: $(PATCHED)

llama/patches/.%.patched: llama/patches/%.patch
	@if git -c user.name=Prism -c user.email=piotr.slupski@pryzmat.pl -C $(WORKDIR) am -3 $(realpath $<); then \
		touch $@;                                                                           \
	else                                                                                    \
		echo "Patch failed. Resolve any conflicts then continue.";                          \
		echo "1. Run 'git -C $(WORKDIR) am --continue'";                                    \
		echo "2. Run 'make -f $(lastword $(MAKEFILE_LIST)) format-patches'";                \
		echo "3. Run 'make -f $(lastword $(MAKEFILE_LIST)) clean apply-patches'";           \
		exit 1;                                                                             \
	fi

.PHONY: checkout
checkout: $(WORKDIR)
	git -C $(WORKDIR) fetch
	git -C $(WORKDIR) checkout -f $(FETCH_HEAD)

$(WORKDIR):
	git clone $(UPSTREAM) $(WORKDIR)

.PHONY: format-patches
format-patches: llama/patches
	git -C $(WORKDIR) format-patch \
		--no-signature \
		--no-numbered \
		--zero-commit \
		-o $(realpath $<) \
		$(FETCH_HEAD)

.PHONY: clean
clean: checkout
	@git -C $(WORKDIR) am --abort || true
	$(RM) llama/patches/.*.patched

.PHONY: print-base
print-base:
	@echo $(FETCH_HEAD)

# Phase 0 / JAISIU-2159 — fails if llama/patches/README.md is stale relative to FETCH_HEAD.
# CI MUST call this on every PR that touches Makefile.sync or llama/patches/.
.PHONY: sync-audit-check
sync-audit-check:
	@echo "Verify llama/patches/README.md references FETCH_HEAD=$(FETCH_HEAD)"
	@grep -q "$(FETCH_HEAD)" llama/patches/README.md || \
		(echo "stale patches README — please re-run sync-audit and refresh 'Pinned commit' + 'Last full audit'" && exit 1)
	@echo "OK: llama/patches/README.md references FETCH_HEAD=$(FETCH_HEAD)"

# Phase 0 / JAISIU-2159 — count local patches + emit Subject: headers for the README table.
# Read-only; safe to run anytime.
.PHONY: print-patches-audit
print-patches-audit:
	@echo "FETCH_HEAD=$(FETCH_HEAD)"
	@echo "patch_count=$$(ls llama/patches/*.patch 2>/dev/null | wc -l)"
	@for f in llama/patches/*.patch; do \
		s=$$(grep -m1 '^Subject:' "$$f" | sed 's/Subject: \[PATCH\] //; s/Subject: //'); \
		echo "$$(basename $$f)|$$s"; \
	done