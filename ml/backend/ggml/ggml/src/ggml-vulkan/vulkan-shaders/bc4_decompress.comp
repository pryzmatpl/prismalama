#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer BC4Block {
    uint8_t blocks[];
};

layout(std430, binding = 1) writeonly buffer OutputF32 {
    float out_data[];
};

layout(push_constant) uniform BlockInfo {
    uint num_blocks;
    uint output_stride;
} info;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= info.num_blocks * 16) return;

    uint block_idx = idx / 16;
    uint elem_idx = idx % 16;

    uint base_offset = block_idx * 8;
    uint8_t p0 = blocks[base_offset];
    uint8_t p1 = blocks[base_offset + 1];

    uint8_t indices_byte = blocks[base_offset + 2 + (elem_idx / 2)];
    uint8_t idx_val = (elem_idx % 2 == 0) ? (indices_byte & 0x0F) : ((indices_byte >> 4) & 0x0F);

    float p0_norm = float(p0) / 255.0;
    float p1_norm = float(p1) / 255.0;

    float t = float(idx_val) / 7.0;
    float val_norm = p0_norm + t * (p1_norm - p0_norm);

    float val = val_norm * 2.0 - 1.0;

    uint out_idx = block_idx * 16 + elem_idx;
    out_data[out_idx] = val;
}