# prismalama-ollama — post-install for systemd + model dir permissions

post_install() {
	if command -v systemd-sysusers >/dev/null 2>&1; then
		systemd-sysusers ollama.conf
	fi
	systemctl daemon-reload 2>/dev/null || true
	echo ""
	echo "Prismalama (Ollama-compatible) installed from this repository."
	echo "  Models:  default /home/models + state under /var/lib/ollama (tmpfiles.d); override OLLAMA_MODELS in /etc/default/ollama — if elsewhere, mkdir + chown ollama and extend ReadWritePaths (systemctl edit ollama.service)"
	echo "  AirLLM:  optional — set OLLAMA_USE_AIRLLM=1 in /etc/default/ollama, then python-pytorch-rocm + pip transformers; see README-PKGBUILD.md"
	echo "  Backends: GGML libs under /usr/lib/ollama/rocm (OLLAMA_LIBRARY_PATH is set in defaults)"
	echo ""
}

post_upgrade() {
	post_install
}

pre_remove() {
	systemctl disable --now ollama.service 2>/dev/null || true
}
