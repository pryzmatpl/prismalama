# prismalama-ollama — post-install for systemd + model dir permissions

post_install() {
	if command -v systemd-sysusers >/dev/null 2>&1; then
		systemd-sysusers ollama.conf
	fi
	systemctl daemon-reload 2>/dev/null || true
	echo ""
	echo "Prismalama (Ollama-compatible) installed from this repository."
	echo "  Models:  set OLLAMA_MODELS in /etc/default/ollama (default /nvme3/models)"
	echo "  AirLLM:  install python-pytorch-rocm for weight streaming; see docs/DEVELOPER.md"
	echo "  Backends: GGML libs under /usr/lib/ollama/rocm (OLLAMA_LIBRARY_PATH is set in defaults)"
	echo ""
}

post_upgrade() {
	post_install
}

pre_remove() {
	systemctl disable --now ollama.service 2>/dev/null || true
}
